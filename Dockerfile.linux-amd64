# Build with --platform linux/amd64; see electron/RELEASE.md.
# The Node image supplies Node.js/npm on Debian 12 (Bookworm).
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-venv \
    python3-pip \
    python3-dev \
    build-essential \
    curl \
    git \
    ca-certificates \
    mafft \
    dpkg \
    fakeroot \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ensembl-go
COPY . .

RUN python3 -m venv /opt/ensembl-go/.venv
ENV PATH="/opt/ensembl-go/.venv/bin:${PATH}"
RUN python -m pip install --upgrade pip \
    && python -m pip install -r backend/requirements-build.txt

RUN npm --prefix frontend ci && npm --prefix electron ci

WORKDIR /opt/ensembl-go/electron
# Electron's npm package no longer downloads the runtime during npm ci.
RUN node node_modules/electron/install.js

CMD ["npm", "run", "dist:linux"]
